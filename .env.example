# ================= ViRaj Rides — Environment Variables =================
# Copy this file to ".env.local" for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Public site URL (used for SEO / Open Graph). Set to your real domain in prod.
NEXT_PUBLIC_SITE_URL=https://virajrides.vercel.app

# ---- Admin dashboard ----
# Key required to view/manage bookings at /admin. CHANGE THIS to something private.
ADMIN_KEY=viraj-admin

# ---- Online payments (Razorpay) ----
# Get these from https://dashboard.razorpay.com → Settings → API Keys.
# If left empty, online payment runs in DEMO mode (no real charge) and COD still works.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- AI Chatbot (optional) ----
# If set, the chatbot uses OpenAI for smart replies. If empty, it uses the
# built-in free rule-based responder (still fully functional).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
